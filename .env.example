# Copie este arquivo para .env.local e preencha com os seus valores.
# NUNCA suba o .env.local para o GitHub.

# Supabase (Project Settings > API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Books (opcional, melhora a busca por ISBN)
VITE_GOOGLE_BOOKS_KEY=

# Nome que aparece na tela e nos e-mails
VITE_NOME_BIBLIOTECA=
NOME_BIBLIOTECA=

# Envio de e-mail pela funcao da Vercel (use uma senha de app do Gmail, nao a senha normal)
GMAIL_USER=
GMAIL_APP_PASSWORD=
